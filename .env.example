# Required for `pnpm run start:http`: shared-secret bearer token that
# callers (payments-toolkit-agent) must present as `Authorization: Bearer
# <token>`. Not used by stdio mode (`pnpm run start`). Generate with e.g.
# `openssl rand -hex 32`; must match the value configured on the caller.
MCP_AUTH_TOKEN=

# Optional: port for `pnpm run start:http` (default 3000).
# PORT=3000

# Optional, deployment only: `dotenv`'s own "injected env (N) from .env"
# line logs via console.error (dotenv@18+), so a platform that classifies
# logs by stream (e.g. Railway) flags it as an error even though nothing
# failed. Not needed for local dev (nothing there cares which stream this
# lands on) — set this as a real platform variable on the deployed service
# instead, not in a local .env, to silence it there.
# DOTENV_CONFIG_QUIET=true
